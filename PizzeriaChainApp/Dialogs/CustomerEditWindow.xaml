<Window x:Class="PizzeriaChainApp.Dialogs.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Клиент" Width="620" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24" HorizontalAlignment="Center">
        <TextBlock x:Name="TextTitle" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Логин" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxLogin" Grid.Row="0" Grid.Column="1" Width="360"
                     IsReadOnly="True" ToolTip="Логин изменить нельзя"/>

            <Label Grid.Row="1" Content="ФИО" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxFio" Grid.Row="1" Grid.Column="1" Width="360"
                     Tag="Иванов Иван Иванович" MaxLength="100"
                     ToolTip="Минимум два слова, только буквы"
                     PreviewTextInput="TextBoxFio_PreviewTextInput"/>

            <Label Grid.Row="2" Content="Телефон" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxPhone" Grid.Row="2" Grid.Column="1" Width="360"
                     Tag="+7XXXXXXXXXX (необязательно)" MaxLength="12"
                     ToolTip="Формат: +7 и 10 цифр"
                     PreviewTextInput="TextBoxPhone_PreviewTextInput"/>

            <Label Grid.Row="3" Content="Email" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxEmail" Grid.Row="3" Grid.Column="1" Width="360"
                     Tag="name@mail.ru (необязательно)" MaxLength="100"
                     ToolTip="Адрес электронной почты"
                     PreviewTextInput="TextBoxEmail_PreviewTextInput"/>

            <Label Grid.Row="4" Content="Бонусы" VerticalAlignment="Center"/>
            <TextBox x:Name="TextBoxBonus" Grid.Row="4" Grid.Column="1" Width="360"
                     Tag="Целое число от 0 до 100000" MaxLength="6"
                     ToolTip="Количество бонусных баллов: от 0 до 100000"
                     PreviewTextInput="TextBoxBonus_PreviewTextInput"/>

            <Label Grid.Row="5" Content="Роль" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboRole" Grid.Row="5" Grid.Column="1" Width="360"
                      ToolTip="Роль пользователя в системе">
                <ComboBoxItem Content="Пользователь" Tag="User"/>
                <ComboBoxItem Content="Администратор" Tag="Admin"/>
            </ComboBox>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="Сохранить" IsDefault="True" ToolTip="Сохранить изменения"
                    Click="ButtonSave_Click"/>
            <Button Content="Отмена" IsCancel="True" ToolTip="Закрыть окно без сохранения"/>
        </StackPanel>
    </StackPanel>
</Window>