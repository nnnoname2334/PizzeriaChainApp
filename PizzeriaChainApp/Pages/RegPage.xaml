<Page x:Class="PizzeriaChainApp.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Margin="0,16">
            <TextBlock Text="Регистрация нового пользователя" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Логин" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxLogin" Grid.Row="0" Grid.Column="1"
                         Tag="Введите логин" MaxLength="30"
                         ToolTip="Латиница, цифры и «_», от 3 до 30 символов"
                         PreviewTextInput="TextBoxLogin_PreviewTextInput"/>

                <Label Grid.Row="1" Content="ФИО" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxFio" Grid.Row="1" Grid.Column="1"
                         Tag="Иванов Иван Иванович" MaxLength="100"
                         ToolTip="Минимум два слова, только буквы"
                         PreviewTextInput="TextBoxFio_PreviewTextInput"/>

                <Label Grid.Row="2" Content="Телефон (необязательно)" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxPhone" Grid.Row="2" Grid.Column="1"
                         Tag="+7XXXXXXXXXX" MaxLength="12"
                         ToolTip="Формат: +7 и 10 цифр"
                         PreviewTextInput="TextBoxPhone_PreviewTextInput"/>

                <Label Grid.Row="3" Content="Пароль" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBoxFirst" Grid.Row="3" Grid.Column="1"
                             MaxLength="50"
                             ToolTip="Минимум 6 символов, английская раскладка, хотя бы одна цифра"
                             PreviewTextInput="PasswordBox_PreviewTextInput"/>

                <Label Grid.Row="4" Content="Подтвердите пароль" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PasswordBoxSecond" Grid.Row="4" Grid.Column="1"
                             MaxLength="50" ToolTip="Повторите пароль"
                             PreviewTextInput="PasswordBox_PreviewTextInput"/>

                <Label Grid.Row="5" Content="Роль" VerticalAlignment="Center"/>
                <ComboBox x:Name="ComboRole" Grid.Row="5" Grid.Column="1"
                          SelectedIndex="0" ToolTip="Выберите роль">
                    <ComboBoxItem Content="Пользователь" Tag="User"/>
                    <ComboBoxItem Content="Администратор" Tag="Admin"/>
                </ComboBox>
            </Grid>

            <Button x:Name="ButtonRegister" Content="Зарегистрироваться"
                    Margin="4,16,4,4" ToolTip="Создать учётную запись"
                    Click="ButtonRegister_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>