<Page x:Class="PizzeriaChainApp.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    <StackPanel Width="270" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Смена пароля" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <Label Content="Логин"/>
        <TextBox x:Name="TextBoxLogin" Tag="Введите логин" MaxLength="30"
                 ToolTip="Логин вашей учётной записи"
                 PreviewTextInput="TextBoxLogin_PreviewTextInput"/>
        <Label Content="Текущий пароль"/>
        <PasswordBox x:Name="PasswordBoxOld" MaxLength="50"
                     ToolTip="Введите текущий пароль"/>
        <Label Content="Новый пароль"/>
        <PasswordBox x:Name="PasswordBoxNew" MaxLength="50"
                     ToolTip="Минимум 6 символов, английская раскладка, хотя бы одна цифра"
                     PreviewTextInput="PasswordBox_PreviewTextInput"/>
        <Label Content="Повторите новый пароль"/>
        <PasswordBox x:Name="PasswordBoxNew2" MaxLength="50"
                     ToolTip="Повторите новый пароль"
                     PreviewTextInput="PasswordBox_PreviewTextInput"/>
        <Button x:Name="ButtonChange" Content="Сменить пароль" Margin="4,16,4,4"
                ToolTip="Сохранить новый пароль" Click="ButtonChange_Click"/>
    </StackPanel>
</Page>