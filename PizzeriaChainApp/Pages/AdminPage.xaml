<Page x:Class="PizzeriaChainApp.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Страница администратора" Loaded="Page_Loaded">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="TextWelcome" FontSize="22" FontWeight="Bold"
                   TextAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="Здесь будет управление данными: добавление, правка, удаление, диаграмма, экспорт."
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Button x:Name="ButtonLogout" Content="Выйти из аккаунта"
                ToolTip="Выйти из учётной записи" Click="ButtonLogout_Click"/>
    </StackPanel>
</Page>