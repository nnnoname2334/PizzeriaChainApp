<Page x:Class="PizzeriaChainApp.Pages.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Клиенты" Loaded="Page_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <TextBox x:Name="TextBoxSearch" Tag="Поиск: логин, ФИО, телефон" MaxLength="100"
                     ToolTip="Поиск по логину, ФИО, телефону или email"
                     TextChanged="Filter_Changed"/>
            <ComboBox x:Name="ComboSort" SelectedIndex="0" ToolTip="Сортировка клиентов"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="ФИО: А–Я"/>
                <ComboBoxItem Content="ФИО: Я–А"/>
                <ComboBoxItem Content="Бонусы по возрастанию"/>
                <ComboBoxItem Content="Бонусы по убыванию"/>
            </ComboBox>
            <ComboBox x:Name="ComboRole" SelectedIndex="0" ToolTip="Фильтр по роли"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все роли" Tag=""/>
                <ComboBoxItem Content="Администраторы" Tag="Admin"/>
                <ComboBoxItem Content="Пользователи" Tag="User"/>
            </ComboBox>
            <Button Content="Очистить фильтры" ToolTip="Сбросить поиск, сортировку и фильтры"
                    Click="ButtonClear_Click"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Margin="0,4,0,4">
            <Button x:Name="ButtonEdit" Content="Изменить" IsEnabled="False"
                    ToolTip="Изменить выбранного клиента (новых клиентов создаёт регистрация)"
                    Click="ButtonEdit_Click"/>
            <Button x:Name="ButtonDelete" Content="Удалить" IsEnabled="False"
                    ToolTip="Удалить выбранного клиента вместе с его заказами"
                    Click="ButtonDelete_Click"/>
        </WrapPanel>

        <DataGrid x:Name="DataGridItems" Grid.Row="2" CanUserSortColumns="False"
                  ToolTip="Список клиентов" SelectionChanged="DataGridItems_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding id}" Width="60"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding full_name}" Width="1.5*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding role}" Width="100"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding phone}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="1.2*"/>
                <DataGridTextColumn Header="Бонусы" Binding="{Binding bonus_points}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TextSummary" Grid.Row="3" Margin="8,4" TextWrapping="Wrap"/>
    </Grid>
</Page>