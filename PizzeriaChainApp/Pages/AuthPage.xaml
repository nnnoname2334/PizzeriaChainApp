<Page x:Class="PizzeriaChainApp.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация" Loaded="Page_Loaded">
    <Grid>
        <!-- Панель входа -->
        <StackPanel x:Name="LoginPanel" Width="270"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <Label Content="Логин"/>
            <TextBox x:Name="TextBoxLogin" Tag="Введите логин" MaxLength="30"
                     ToolTip="Введите логин (латиница, цифры, «_»)"
                     PreviewTextInput="TextBoxLogin_PreviewTextInput"/>
            <Label Content="Пароль"/>
            <PasswordBox x:Name="PasswordBox" MaxLength="50"
                         ToolTip="Введите пароль"/>
            <Button x:Name="ButtonEnter" Content="Вход" IsDefault="True"
                    Margin="4,16,4,4" ToolTip="Войти в систему"
                    Click="ButtonEnter_Click"/>
            <Button x:Name="ButtonReg" Content="Регистрация"
                    ToolTip="Создать новую учётную запись"
                    Click="ButtonReg_Click"/>
            <Button x:Name="ButtonChangePassword" Content="Смена пароля"
                    ToolTip="Изменить пароль существующей учётной записи"
                    Click="ButtonChangePassword_Click"/>
        </StackPanel>

        <!-- Панель капчи (показывается после 3 неверных попыток) -->
        <StackPanel x:Name="CaptchaPanel" Width="270" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Проверка: введите символы" FontSize="20" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    CornerRadius="6" Padding="12" Margin="4">
                <TextBlock x:Name="CaptchaText" FontSize="32" FontStyle="Italic"
                           FontWeight="Bold" TextAlignment="Center"
                           Foreground="{DynamicResource ErrorBrush}"
                           TextDecorations="Strikethrough"/>
            </Border>
            <TextBox x:Name="CaptchaInput" Tag="Введите капчу" MaxLength="6"
                     ToolTip="Введите символы, показанные выше (с учётом регистра)"/>
            <Button x:Name="ButtonSubmitCaptcha" Content="Подтвердить"
                    Margin="4,16,4,4" ToolTip="Подтвердить капчу"
                    Click="ButtonSubmitCaptcha_Click"/>
            <Button x:Name="ButtonRefreshCaptcha" Content="Обновить капчу"
                    ToolTip="Сгенерировать новый код"
                    Click="ButtonRefreshCaptcha_Click"/>
        </StackPanel>
    </Grid>
</Page>