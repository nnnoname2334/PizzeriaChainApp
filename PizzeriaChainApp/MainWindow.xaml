<Window x:Class="PizzeriaChainApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Сеть пиццерий" Height="600" Width="900"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Назад, заголовок страницы, смена темы -->
        <Grid Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ButtonBack" Grid.Column="0" Content="Назад"
                    ToolTip="Вернуться на предыдущую страницу"
                    Visibility="Hidden" Click="ButtonBack_Click"/>

            <TextBlock x:Name="PageTitleText" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" FontWeight="Bold"/>

            <Button x:Name="ButtonTheme" Grid.Column="2" Content="Сменить тему"
                    ToolTip="Переключить светлую и тёмную тему"
                    Click="ButtonTheme_Click"/>
        </Grid>

        <!-- Сюда загружаются страницы -->
        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>

        <!-- Нижняя панель: дата и время -->
        <Grid Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}">
            <TextBlock x:Name="DateTimeNow"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
        </Grid>
    </Grid>
</Window>